component CopyCodeButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    callback dismissed();
    width: 104px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #ececec;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: keyboard;

    Text {
        text: root.label;
        color: #1a1a1a;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        border-radius: root.border-radius;
        background: pointer.has-hover ? #284e7912 : transparent;
    }

    keyboard := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }
    }

    pointer := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    if keyboard.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: #4c8074;
    }
}

component SmsBodyText inherits Text {
    color: #25322e;
    font-size: 14px;
    line-height-factor: 1.12;
    wrap: word-wrap;
}

component ScrollArrow inherits TouchArea {
    in property <bool> down;
    height: 10px;
    accessible-role: button;
    accessible-action-default => { self.clicked(); }

    Path {
        x: 2px;
        y: 3px;
        width: 6px;
        height: 4px;
        viewbox-width: 6;
        viewbox-height: 4;
        commands: root.down ? "M 0 0 L 6 0 L 3 4 Z" : "M 0 4 L 3 0 L 6 4 Z";
        fill: #8b8b8b;
    }
}

export component SmsWindow inherits Window {
    in property <bool> chinese;
    in property <string> otp;
    in property <string> sms;
    in property <string> sender-name;
    private property <length> body-top: root.otp != "" ? 86px : 42px;
    private property <length> footer-height: 47px;
    private property <bool> scrolls: unscrolled.height > 240px - root.body-top - root.footer-height;
    callback copy-code();
    callback dismiss();

    title: root.chinese ? "鹊信 · 新短信" : "Pin Glide · New SMS";
    no-frame: true;
    width: 380px;
    height: min(240px, root.body-top + original-text.height + root.footer-height);
    background: #ffffff;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;

    Rectangle {
        border-width: 1px;
        border-color: #dfe5e3;

        TouchArea {
            clicked => { root.dismiss(); }
        }

        VerticalLayout {
            x: 14px;
            y: 14px;
            width: root.width - 28px;
            height: root.body-top - 22px;
            spacing: 8px;

            HorizontalLayout {
                height: 20px;
                spacing: 4px;
                Image {
                    source: @image-url("assets/app-icon.png");
                    width: 20px;
                    height: 20px;
                }

                Text {
                    text: root.chinese ? "鹊信" : "Pin Glide";
                    font-size: 13px;
                    color: #25322e;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            if root.otp != "": HorizontalLayout {
                height: 36px;
                spacing: 12px;

                Text {
                    horizontal-stretch: 1;
                    text: root.otp;
                    font-size: 30px;
                    font-weight: 600;
                    color: #25322e;
                    overflow: elide;
                    vertical-alignment: center;
                }

                CopyCodeButton {
                    label: root.chinese ? "复制验证码" : "Copy code";
                    clicked => { root.copy-code(); }
                    dismissed => { root.dismiss(); }
                }
            }
        }

        unscrolled := SmsBodyText {
            visible: false;
            width: root.width - 28px;
            text: root.sms;
        }

        body := Flickable {
            x: 14px;
            y: root.body-top;
            width: root.width - 28px - (root.scrolls ? 10px : 0px);
            height: root.height - root.body-top - root.footer-height;
            content-height: original-text.height;
            content-width: self.width;
            mouse-drag-pan-enabled: false;
            accessible-role: region;
            accessible-label: root.chinese ? "短信正文" : "SMS body";
            forward-focus: body-keyboard;

            original-text := SmsBodyText {
                x: 0;
                y: 0;
                width: body.width;
                text: root.sms;
            }

            TouchArea {
                x: 0;
                y: 0;
                width: body.width;
                height: max(body.height, original-text.height);
                clicked => { root.dismiss(); }
            }
        }

        body-keyboard := FocusScope {
            x: 0;
            width: 0;

            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.dismiss();
                    return accept;
                }
                if !root.scrolls {
                    return reject;
                }
                if event.text == Key.UpArrow {
                    scrollbar.scroll-to(body.content-y + 20px);
                } else if event.text == Key.DownArrow {
                    scrollbar.scroll-to(body.content-y - 20px);
                } else if event.text == Key.PageUp {
                    scrollbar.scroll-to(body.content-y + body.height);
                } else if event.text == Key.PageDown {
                    scrollbar.scroll-to(body.content-y - body.height);
                } else {
                    return reject;
                }
                return accept;
            }
        }

        scrollbar := Rectangle {
            private property <length> overflow-height: body.content-height - body.height;
            private property <length> travel: track.height - thumb.height;

            function scroll-to(position: length) {
                body.content-y = position.clamp(-self.overflow-height, 0px);
            }

            x: body.x + body.width;
            y: body.y;
            width: 10px;
            height: body.height;
            background: #fafafa;
            visible: root.scrolls;

            TouchArea {
                scroll-event(event) => {
                    parent.scroll-to(body.content-y + event.delta-y);
                    return accept;
                }
            }

            track := TouchArea {
                private property <length> start-y;
                private property <length> start-offset;
                y: 10px;
                height: parent.height - 20px;

                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        if self.mouse-y < thumb.y || self.mouse-y >= thumb.y + thumb.height {
                            parent.scroll-to(body.content-y + (self.mouse-y < thumb.y ? body.height : -body.height));
                        }
                        self.start-y = self.mouse-y;
                        self.start-offset = body.content-y;
                    }
                }

                moved => {
                    if self.pressed && parent.travel > 0px {
                        parent.scroll-to(self.start-offset - (self.mouse-y - self.start-y) * parent.overflow-height / parent.travel);
                    }
                }

                scroll-event(event) => {
                    parent.scroll-to(body.content-y + event.delta-y);
                    return accept;
                }

                thumb := Rectangle {
                    x: 2px;
                    y: scrollbar.travel * -body.content-y / max(1px, scrollbar.overflow-height);
                    width: 6px;
                    height: max(18px, parent.height * body.height / max(1px, body.content-height));
                    border-radius: 3px;
                    background: #8b8b8b;
                }
            }

            ScrollArrow {
                y: 0;
                accessible-label: root.chinese ? "向上滚动" : "Scroll up";
                clicked => { parent.scroll-to(body.content-y + 20px); }
            }

            ScrollArrow {
                y: parent.height - self.height;
                down: true;
                accessible-label: root.chinese ? "向下滚动" : "Scroll down";
                clicked => { parent.scroll-to(body.content-y - 20px); }
            }
        }

        if body-keyboard.has-focus: Rectangle {
            x: body.x;
            y: body.y;
            width: body.width + (root.scrolls ? scrollbar.width : 0px);
            height: body.height;
            border-width: 2px;
            border-color: #4c8074;
        }

        VerticalLayout {
            x: 14px;
            y: root.height - root.footer-height + 8px;
            width: root.width - 28px;
            height: 25px;
            spacing: 8px;

            Rectangle {
                height: 1px;
                background: #dfe5e3;
            }

            Text {
                height: 15px;
                text: root.sender-name;
                font-size: 11px;
                color: #65716e;
                overflow: elide;
            }
        }
    }
}
