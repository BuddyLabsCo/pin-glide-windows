import {
    Button,
    ComboBox,
    LineEdit,
    Palette,
    ScrollView,
    Switch,
} from "std-widgets.slint";
import { BackButton } from "back_button.slint";

export enum PopupDurationError { None, Invalid, Save }

component SettingCard inherits Rectangle {
    in property <string> label;
    in property <string> error;
    in property <string> label-error;
    background: white;
    border-color: #deebe5;
    border-width: 1px;
    border-radius: 8px;
    height: content.preferred-height;

    content := VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        HorizontalLayout {
            height: 52px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                Text {
                    text: root.label;
                    font-weight: 600;
                    color: #25322e;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }

                if root.label-error != "": Text {
                    text: root.label-error;
                    color: #903d34;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            @children
        }

        if root.error != "": VerticalLayout {
            padding-bottom: 10px;
            Text {
                text: root.error;
                color: #903d34;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}

export component SettingsWindow inherits Window {
    in property <bool> chinese;
    in property <string> language-error;
    in property <string> startup-error;
    in property <PopupDurationError> popup-duration-error;
    in-out property <string> popup-duration;
    in-out property <int> language-index;
    in-out property <bool> startup;
    callback back();
    callback choose-language(int);
    callback toggle-startup(bool);
    callback apply-popup-duration(string);
    private property <string> heading: root.chinese ? "设置" : "Settings";
    private property <string> duration-error-label:
        root.popup-duration-error == PopupDurationError.Invalid
        ? (root.chinese ? "请输入大于零的整数秒数。" : "Enter whole seconds greater than zero.")
        : root.popup-duration-error == PopupDurationError.Save
        ? (root.chinese ? "无法保存弹窗显示时长，请重试。" : "Could not save the duration. Try again.")
        : "";

    title: root.chinese ? "鹊信 · 设置" : "Pin Glide · Settings";
    icon: @image-url("assets/app-icon.png");
    min-width: 420px;
    max-width: 420px;
    min-height: 392px;
    max-height: 392px;
    background: #f1f8f5;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    init => { Palette.color-scheme = ColorScheme.light; }

    public function focus-page() {
        page-focus.focus();
    }

    page-focus := FocusScope {
        width: 0px;
        height: 0px;
        focus-on-tab-navigation: false;
    }

    TouchArea {
        clicked => { root.focus-page(); }
    }

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            height: 32px;
            spacing: 10px;
            BackButton {
                label: root.chinese ? "返回主窗口" : "Back to Main";
                clicked => { root.back(); }
            }

            Text {
                text: root.heading;
                font-size: 22px;
                font-weight: 600;
                color: #22312f;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: 8px;
                SettingCard {
                    label: root.chinese ? "界面语言" : "Interface language";
                    error: root.language-error;
                    ComboBox {
                        width: 128px;
                        model: [root.chinese ? "跟随系统" : "Follow system", "中文", "English"];
                        current-index <=> root.language-index;
                        accessible-label: parent.label;
                        selected => { root.choose-language(self.current-index); }
                    }
                }

                SettingCard {
                    label: root.chinese ? "开机启动" : "Launch at login";
                    error: root.startup-error;
                    Switch {
                        width: 40px;
                        checked <=> root.startup;
                        accessible-label: parent.label;
                        toggled => { root.toggle-startup(self.checked); }
                    }
                }

                SettingCard {
                    label: root.chinese ? "复制验证码快捷键" : "Copy code shortcut";
                    LineEdit {
                        width: 106px;
                        text: root.chinese ? "未设置" : "Unassigned";
                        read-only: true;
                        accessible-label: parent.label;
                    }

                    Button {
                        text: root.chinese ? "修改" : "Change";
                        width: root.chinese ? 52px : 64px;
                        enabled: false;
                    }

                    Button {
                        text: root.chinese ? "清除" : "Clear";
                        width: 52px;
                        enabled: false;
                    }
                }

                SettingCard {
                    label: root.chinese ? "弹窗显示时长" : "Popup duration";
                    label-error: root.duration-error-label;
                    Rectangle {
                        width: 56px;
                        height: 32px;
                        background: white;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.duration-error-label != "" ? #903d34 : #e5e5e5;

                        TouchArea {
                            mouse-cursor: text;
                            clicked => { duration.focus(); }
                        }

                        Rectangle {
                            x: 11px;
                            width: parent.width - 22px;
                            height: parent.height;
                            clip: true;

                            duration := TextInput {
                                private property <length> caret-x;
                                x: min(0px, max(parent.width - self.width, parent.width - self.caret-x - self.text-cursor-width));
                                width: max(parent.width, self.preferred-width + self.text-cursor-width);
                                height: parent.height;
                                text <=> root.popup-duration;
                                color: #242424;
                                vertical-alignment: center;
                                single-line: true;
                                input-method-hints: { capitalization: none, auto-correct: false, auto-complete: false };
                                accessible-label: root.chinese ? "弹窗显示时长（秒）" : "Popup duration (seconds)";
                                accessible-description: root.duration-error-label;
                                cursor-position-changed(position) => { self.caret-x = position.x; }
                                changed has-focus => {
                                    if !self.has-focus {
                                        root.apply-popup-duration(self.text);
                                    }
                                }
                            }
                        }

                        if duration.has-focus: Rectangle {
                            border-radius: parent.border-radius;
                            border-width: 1px;
                            border-color: #101010;
                        }
                    }

                    Text {
                        text: root.chinese ? "秒" : "s";
                        width: 14px;
                        font-size: 13px;
                        color: #65716e;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
