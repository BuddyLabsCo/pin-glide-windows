import { NamePaste, SenderNameForm } from "pairing.slint";

component RowAction inherits Rectangle {
    in property <string> label;
    in property <bool> filled;
    in property <bool> destructive;
    in property <bool> enabled: true;
    callback clicked(bool);
    width: 56px;
    height: 32px;
    border-radius: root.destructive ? 6px : 4px;
    border-width: 1px;
    border-color: root.destructive ? transparent : root.filled ? #006b60 : #dde5e1;
    background: root.destructive ? (press.pressed ? #801b14 : press.has-hover ? #9e1f16 : #b42318)
        : root.filled ? #006b60 : white;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked(false);
        }
    }
    forward-focus: keys;

    Text {
        text: root.label;
        color: root.filled || root.destructive ? white : black;
        font-weight: root.destructive ? 600 : 400;
    }

    if keys.has-focus: Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-width: 2px;
        border-color: root.destructive ? #b42318 : #284e79;
        border-radius: 8px;
    }

    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked(false);
                return accept;
            }
            return reject;
        }
    }

    press := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(true); }
    }
}

export struct SenderRowData {
    pairing-id: string,
    name: string,
    needs-repair: bool,
}

export component SenderRow inherits Rectangle {
    in property <SenderRowData> device;
    in property <bool> chinese;
    in property <bool> expanded;
    in property <bool> separator;
    in property <bool> focus-requested;
    in property <bool> focus-by-pointer;
    in property <length> editor-height;
    in-out property <string> error;
    private property <bool> invalid-paste;
    private property <string> draft;
    private property <bool> pointer-focus;
    callback toggle();
    callback rename(string, bool) -> string;
    callback delete-local(bool) -> string;
    callback read-paste() -> NamePaste;
    callback insert-paste(string);
    callback reveal-editor();
    callback reveal-row();

    init => {
        if root.focus-requested {
            root.focus-row(root.focus-by-pointer);
        }
    }

    changed focus-requested => {
        if root.focus-requested {
            root.focus-row(root.focus-by-pointer);
        }
    }

    function toggle-row(pointer: bool) {
        root.toggle();
        if root.expanded && !root.device.needs-repair {
            root.draft = root.device.name;
            root.invalid-paste = false;
            field.focus-draft();
        } else {
            root.focus-row(pointer);
        }
    }

    function focus-row(pointer: bool) {
        keys.focus();
        root.pointer-focus = pointer;
        if !root.expanded {
            root.reveal-row();
        }
    }

    function save(pointer: bool) {
        root.error = root.rename(root.draft, root.invalid-paste);
        if root.error == "" {
            root.toggle-row(pointer);
        } else {
            field.focus-name();
            root.reveal-editor();
        }
    }

    changed error => {
        if root.expanded {
            root.reveal-editor();
        }
    }

    header := Rectangle {
        x: 1px;
        y: 0px;
        width: parent.width - 2px;
        height: 48px;
        border-radius: 9px;
        background: press.has-hover ? #006b6012 : transparent;
        border-width: keys.has-focus && !root.pointer-focus ? 2px : 0px;
        border-color: #006b60;
        accessible-role: button;
        accessible-label: (root.chinese
            ? (root.expanded ? "收起 " : root.device.needs-repair ? "展开需要重新配对的设备 " : "编辑名称 ")
            : (root.expanded ? "Collapse " : root.device.needs-repair ? "Expand device that needs pairing again " : "Edit name "))
            + root.device.name;
        accessible-expanded: root.expanded;
        accessible-action-default => { root.toggle-row(false); }
        forward-focus: keys;

        HorizontalLayout {
            padding-left: 15px;
            padding-right: 11px;
            spacing: 12px;
            Rectangle {
                width: 20px;
                Rectangle {
                    width: 16px;
                    height: 20px;
                    border-radius: 4px;
                    border-width: 1.5px;
                    border-color: #4c8074;
                    Rectangle {
                        y: 14px;
                        width: 5px;
                        height: 1.5px;
                        border-radius: 1px;
                        background: #4c8074;
                    }
                }
            }

            Text {
                text: root.device.name;
                color: #25322e;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
            }

            if root.device.needs-repair: Text {
                text: root.chinese ? "需要重新配对" : "Needs pairing again";
                font-size: 12px;
                color: #805724;
                vertical-alignment: center;
            }

            Rectangle {
                width: 32px;
                Path {
                    width: 12px;
                    height: 8px;
                    viewbox-width: 12;
                    viewbox-height: 8;
                    commands: root.expanded ? "M 1 6 L 6 2 L 11 6" : "M 1 2 L 6 6 L 11 2";
                    stroke: #4c8074;
                    stroke-width: 1.5px;
                }
            }
        }

        keys := FocusScope {
            changed has-focus => {
                if !self.has-focus {
                    root.pointer-focus = false;
                }
            }
            key-pressed(event) => {
                if event.text == Key.Tab && !event.modifiers.shift
                    && root.expanded && root.device.needs-repair {
                    delete-action.focus();
                    return accept;
                }
                if event.text == Key.Return || event.text == Key.Space
                    || (event.text == Key.Escape && root.expanded) {
                    root.toggle-row(false);
                    return accept;
                }
                return reject;
            }
        }

        press := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggle-row(true); }
        }
    }

    FocusScope {
        y: header.height;
        height: root.editor-height;
        visible: root.expanded;
        enabled: root.expanded;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.toggle-row(false);
                return accept;
            }
            return reject;
        }

        field := SenderNameForm {
            x: 16px;
            y: 0px;
            width: parent.width - 32px;
            height: root.error == "" ? 52px : 76px;
            visible: !root.device.needs-repair;
            editable: root.expanded && !root.device.needs-repair;
            compact: true;
            chinese: root.chinese;
            name <=> root.draft;
            error <=> root.error;
            invalid-paste <=> root.invalid-paste;
            done => { root.save(false); }
            read-paste => { root.read-paste() }
            insert-paste(text) => { root.insert-paste(text); }
        }

        if !root.device.needs-repair: RowAction {
            x: parent.width - 136px;
            y: parent.height - 44px;
            label: root.chinese ? "取消" : "Cancel";
            enabled: root.expanded;
            clicked(pointer) => { root.toggle-row(pointer); }
        }

        if !root.device.needs-repair: RowAction {
            x: parent.width - 72px;
            y: parent.height - 44px;
            label: root.chinese ? "保存" : "Save";
            filled: true;
            enabled: root.expanded;
            clicked(pointer) => { root.save(pointer); }
        }

        delete-action := RowAction {
            x: parent.width - 72px;
            y: 6px;
            label: root.chinese ? "删除" : "Delete";
            destructive: true;
            visible: root.device.needs-repair;
            enabled: root.expanded && root.device.needs-repair;
            clicked(pointer) => { root.error = root.delete-local(pointer); }
        }

        if root.device.needs-repair && root.error != "": Text {
            x: 16px;
            y: 44px;
            width: parent.width - 32px;
            height: 20px;
            text: root.error;
            color: #903d34;
            font-size: 13px;
        }
    }

    if root.separator: Rectangle {
        x: 1px;
        y: 48px + root.editor-height;
        width: parent.width - 2px;
        height: 1px;
        background: #dfe5e3;
    }
}
