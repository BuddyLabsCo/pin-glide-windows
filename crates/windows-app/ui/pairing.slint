import { Button, Palette } from "std-widgets.slint";
import { BackButton } from "back_button.slint";

struct NamePaste {
    text: string,
    error: string,
    invalid-text: bool,
}

component SenderNameForm inherits Rectangle {
    in property <bool> chinese;
    in-out property <string> name;
    in-out property <string> error;
    in-out property <bool> invalid-paste;
    out property <bool> name-focused: field.has-focus;
    callback read-paste() -> NamePaste;
    callback insert-paste(string);
    callback done();
    public function focus-name() {
        field.focus();
    }
    public function paste-name() {
        field.focus();
        let pasted = root.read-paste();
        root.invalid-paste = pasted.invalid-text;
        root.error = pasted.error;
        if pasted.text != "" {
            root.insert-paste(pasted.text);
        }
    }

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 20px;
        text: root.chinese ? "设备名称" : "Device name";
        color: #22312f;
        horizontal-alignment: left;
    }

    Rectangle {
        x: 0px;
        y: 24px;
        width: parent.width;
        height: 36px;
        background: white;
        border-width: root.error != "" ? 1px : field.has-focus ? 2px : 1px;
        border-radius: 4px;
        border-color: root.error != "" ? #903d34 : field.has-focus ? #284e79 : #d1d1d1;

        Rectangle {
            clip: true;
            x: 11px;
            width: parent.width - 22px;
            ContextMenuArea {
                Menu {
                    MenuItem {
                        title: root.chinese ? "撤消" : "Undo";
                        activated => { field.undo(); }
                    }

                    MenuItem {
                        title: root.chinese ? "重做" : "Redo";
                        activated => { field.redo(); }
                    }

                    MenuSeparator { }

                    MenuItem {
                        title: root.chinese ? "剪切" : "Cut";
                        enabled: field.has-selection;
                        activated => { field.cut(); }
                    }

                    MenuItem {
                        title: root.chinese ? "复制" : "Copy";
                        enabled: field.has-selection;
                        activated => { field.copy(); }
                    }

                    MenuItem {
                        title: root.chinese ? "粘贴" : "Paste";
                        activated => { root.paste-name(); }
                    }

                    MenuItem {
                        title: root.chinese ? "全选" : "Select All";
                        enabled: root.name != "";
                        activated => { field.select-all(); }
                    }
                }

                Text {
                    width: parent.width;
                    text: root.invalid-paste ? "�" : root.chinese ? "输入设备名称" : "Enter device name";
                    visible: root.name == "" && field.preedit-text == "";
                    color: root.invalid-paste ? #242424 : #757575;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }

                field := TextInput {
                    property <length> offset;
                    x: offset;
                    width: max(parent.width - 1px, self.preferred-width);
                    height: 100%;
                    color: #242424;
                    vertical-alignment: center;
                    single-line: true;
                    text <=> root.name;
                    accessible-label: root.chinese ? "设备名称" : "Device name";
                    accessible-description: root.error;
                    cursor-position-changed(position) => {
                        if position.x + self.offset > parent.width - 1px {
                            self.offset = parent.width - 1px - position.x;
                        } else if position.x + self.offset < 0px {
                            self.offset = -position.x;
                        }
                    }
                    key-pressed(event) => {
                        if (event.modifiers.control && (event.text == "v" || event.text == "V"))
                            || (event.modifiers.shift && event.text == Key.Insert) {
                            root.paste-name();
                            return accept;
                        }
                        return reject;
                    }
                    edited => { root.error = ""; root.invalid-paste = false; }
                    accepted => { root.done(); }
                }
            }
        }
    }

    Text {
        x: 0px;
        y: 65px;
        width: parent.width;
        height: 20px;
        text: root.error;
        color: #903d34;
        font-size: 13px;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 112px;
        y: 101px;
        width: 112px;
        height: 36px;
        property <string> label: root.chinese ? "完成" : "Done";
        border-radius: 4px;
        background: #005fb8;
        accessible-role: button;
        accessible-label: self.label;
        accessible-action-default => { root.done(); }
        forward-focus: done-focus;

        Text {
            text: parent.label;
            color: white;
            font-weight: 600;
        }

        Rectangle {
            border-radius: 4px;
            background: done-touch.has-hover ? #284e7912 : transparent;
        }

        if done-focus.has-focus: Rectangle {
            x: -4px;
            y: -4px;
            width: parent.width + 8px;
            height: parent.height + 8px;
            border-width: 2px;
            border-radius: 6px;
            border-color: #284e79;
        }
        done-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Return || event.text == Key.Space {
                    root.done();
                    return accept;
                }
                return reject;
            }
        }

        done-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.done(); }
        }
    }
}

component QrLoading inherits Rectangle {
    in property <float> seconds;
    pure function pulse(offset: float) -> float {
        let phase = mod(root.seconds + 1.8 - offset, 1.8);
        let strength = max(0.0, 1.0 - abs(phase - 0.42) / 0.42);
        return strength * strength * (3 - 2 * strength);
    }

    for corner[index] in [{ x: 12px, y: 12px }, { x: 108px, y: 12px }, { x: 12px, y: 108px }]: marker := Rectangle {
        property <float> glow: root.pulse(index * 0.34);
        x: corner.x;
        y: corner.y;
        width: 40px;
        height: 40px;
        border-radius: 7px;
        border-width: 2px;
        border-color: #deebe5;
        Rectangle {
            border-radius: 7px;
            border-width: 2px;
            border-color: #79bda9;
            opacity: marker.glow;
        }

        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 4px;
            background: #e1efe9;
            Rectangle {
                background: #52a68e;
                border-radius: 4px;
                opacity: marker.glow;
            }
        }
    }

    for tile in [
        { x: 72px, y: 24px },
        { x: 88px, y: 40px },
        { x: 72px, y: 56px },
        { x: 24px, y: 72px },
        { x: 40px, y: 88px },
        { x: 56px, y: 72px },
        { x: 72px, y: 88px },
        { x: 88px, y: 72px },
        { x: 104px, y: 88px },
        { x: 120px, y: 72px },
        { x: 136px, y: 88px },
        { x: 72px, y: 120px },
        { x: 88px, y: 104px },
        { x: 104px, y: 120px },
        { x: 120px, y: 104px },
        { x: 136px, y: 120px },
        { x: 88px, y: 136px },
        { x: 120px, y: 136px }
    ]: Rectangle {
        x: tile.x;
        y: tile.y;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: #eaf2ee;
        Rectangle {
            border-radius: 2px;
            background: #8ec6b4;
            opacity: root.pulse((tile.x + tile.y) / 320px);
        }
    }
}

export enum PairingStage {
    preparing,
    waiting,
    confirming,
    credential-ready,
    checking,
    connecting,
    completed,
    failed,
    create-failed,
    expired,
    canceled,
}

export component PairingWindow inherits Window {
    in property <bool> chinese;
    in property <bool> adding-device;
    in property <bool> motion-enabled;
    in property <bool> completion-motion;
    in property <PairingStage> stage;
    in property <image> qr;
    in property <string> remaining;
    in-out property <string> sender-name;
    in-out property <string> name-error;
    in-out property <bool> invalid-paste;
    out property <bool> name-focused: name-form.name-focused;
    callback refresh();
    callback back();
    callback finish-naming();
    callback read-name-paste() -> NamePaste;
    callback insert-name-paste(string);
    public function focus-name() {
        name-form.focus-name();
    }
    public function paste-name() {
        name-form.paste-name();
    }
    private property <bool> loading: stage == PairingStage.preparing || stage == PairingStage.confirming
        || stage == PairingStage.credential-ready || stage == PairingStage.checking
        || stage == PairingStage.connecting;
    private property <bool> waiting: stage == PairingStage.waiting;
    private property <bool> completed: stage == PairingStage.completed;
    private property <bool> problem: !loading && !waiting && !completed;
    private property <string> progress: stage == PairingStage.preparing ? (chinese ? "正在准备二维码…" : "Preparing QR code…")
        : stage == PairingStage.waiting ? (chinese ? "等待扫码，剩余 " : "Waiting for scan · ") + remaining
        : stage == PairingStage.confirming ? (chinese ? "正在配对…" : "Pairing…")
        : stage == PairingStage.credential-ready ? (chinese ? "正在准备接收端…" : "Preparing the Receiver…")
        : stage == PairingStage.checking ? (chinese ? "正在核实注册结果…" : "Checking the registration result…")
        : stage == PairingStage.connecting ? (chinese ? "正在连接接收服务…" : "Connecting to the delivery service…")
        : stage == PairingStage.completed ? (chinese ? "配对完成" : "Pairing complete")
        : stage == PairingStage.create-failed ? (chinese ? "无法准备配对二维码。" : "Could not prepare the pairing QR code.")
        : stage == PairingStage.expired ? (chinese ? "二维码已过期。" : "The QR code has expired.")
        : stage == PairingStage.canceled ? (chinese ? "配对已取消。" : "Pairing was canceled.")
        : (chinese ? "配对失败，请重试。" : "Pairing failed. Please try again.");

    title: chinese ? "鹊信" : "Pin Glide";
    icon: @image-url("assets/app-icon.png");
    min-width: 440px;
    max-width: 440px;
    min-height: 560px;
    max-height: 560px;
    background: #fafcfb;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    init => { Palette.color-scheme = ColorScheme.light; }

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        HorizontalLayout {
            height: 32px;
            spacing: 10px;
            if root.adding-device: BackButton {
                label: root.chinese ? "返回主窗口" : "Back to main window";
                clicked => { root.back(); }
            }

            Text {
                text: root.adding-device ? (root.chinese ? "添加设备" : "Add a device") : (root.chinese ? "配对" : "Pairing");
                font-size: 22px;
                font-weight: 600;
                color: #22312f;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            padding-top: 16px;
            Rectangle {
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 176px;
                height: 176px;
                background: white;
                border-radius: 12px;
                border-width: 1px;
                border-color: #dbe8e2;
                if root.completed: Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: #e3f3ec;
                    Path {
                        width: 28px;
                        height: 28px;
                        commands: "M 4 14 L 11 21 L 24 8";
                        stroke: #177761;
                        stroke-width: 2.5px;
                    }
                }
                if root.loading || (root.completed && root.motion-enabled && root.completion-motion): Rectangle {
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #dbe8e2;
                    background: white;
                    opacity: root.loading ? 1 : 0;
                    animate opacity {
                        duration: root.motion-enabled && root.completed ? 180ms : 0ms;
                        easing: linear;
                    }
                    QrLoading {
                        width: 160px;
                        height: 160px;
                        seconds: root.motion-enabled && parent.opacity > 0 ? mod(animation-tick(), 1.8s) / 1s : 0.68;
                    }
                }
                if root.waiting: Image {
                    source: root.qr;
                    image-rendering: pixelated;
                    width: 160px;
                    height: 160px;
                }
                if root.problem: Rectangle {
                    width: 72px;
                    height: 72px;
                    border-radius: 36px;
                    background: #fbede7;
                    Text {
                        text: "!";
                        font-size: 32px;
                        font-weight: 600;
                        color: #903d34;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        Text {
            text: root.progress;
            font-size: 14px;
            color: root.problem ? #903d34 : #21736b;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        if root.waiting: Text {
            text: root.chinese ? "打开目标设备上的鹊信，扫描二维码并确认。"
                : "Open Pin Glide on the other device, scan the QR code, and confirm.";
            font-size: 13px;
            color: #65716e;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        if root.problem: HorizontalLayout {
            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                min-width: 120px;
                height: 36px;
                text: root.chinese ? "刷新二维码" : "Refresh QR code";
                clicked => { root.refresh(); }
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }

    name-form := SenderNameForm {
        visible: root.completed;
        x: 68px;
        y: 320px;
        width: 304px;
        height: 137px;
        chinese: root.chinese;
        name <=> root.sender-name;
        error <=> root.name-error;
        invalid-paste <=> root.invalid-paste;
        read-paste => { root.read-name-paste() }
        insert-paste(text) => { root.insert-name-paste(text); }
        done => { root.finish-naming(); }
    }
}
