import { Button, Palette, ScrollView } from "std-widgets.slint";
import { NamePaste } from "pairing.slint";
import { SenderRow, SenderRowData } from "sender_row.slint";
import { SenderScrollbar } from "sender_scrollbar.slint";

export component MainWindow inherits Window {
    in property <bool> chinese;
    in property <bool> receiver-revoked;
    in property <bool> receiver-credential-missing;
    in property <[SenderRowData]> sender-devices;
    private property <int> editor: -1;
    private property <string> editor-error;
    private property <bool> focus-first-row;
    private property <bool> focus-by-pointer;
    private property <length> editor-height: root.editor < 0 ? 0px
        : (root.sender-devices[root.editor].needs-repair ? 44px : 100px)
        + (root.editor-error == "" ? 0px : 24px);
    callback open-pairing();
    callback open-settings();
    callback rename-sender(int, string, bool) -> string;
    callback delete-sender(int, bool) -> string;
    callback read-name-paste() -> NamePaste;
    callback insert-name-paste(string);

    public function close-editor() {
        root.editor = -1;
        root.editor-error = "";
        root.focus-first-row = false;
    }

    public function clear-editor-error() {
        root.editor-error = "";
    }

    public function focus-first-sender(pointer: bool) {
        root.focus-by-pointer = pointer;
        root.focus-first-row = true;
    }

    function reveal(top: length, bottom: length) {
        let offset = -sender-scroll.content-y;
        let target = max(bottom - sender-scroll.visible-height, min(top, offset));
        sender-scroll.content-y = -clamp(target, 0px, max(0px, list.height - sender-scroll.visible-height));
    }

    title: root.chinese ? "鹊信" : "Pin Glide";
    icon: @image-url("assets/app-icon.png");
    min-width: 400px;
    max-width: 400px;
    min-height: 576px;
    max-height: 576px;
    background: #f1f8f5;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    init => { Palette.color-scheme = ColorScheme.light; }

    VerticalLayout {
        padding: 24px;
        padding-bottom: 16px;
        spacing: 16px;
        HorizontalLayout {
            height: 32px;
            spacing: 10px;
            Image {
                source: @image-url("assets/app-icon.png");
                width: 32px;
                height: 32px;
            }

            Text {
                text: root.title;
                font-size: 18px;
                font-weight: 600;
                color: #22312f;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 32px;
                height: 32px;
                Button {
                    width: parent.width;
                    height: parent.height;
                    accessible-label: root.chinese ? "设置" : "Settings";
                    clicked => { root.open-settings(); }
                }

                Path {
                    width: 18px;
                    height: 18px;
                    viewbox-width: 20;
                    viewbox-height: 20;
                    commands: "M 8 2 L 12 2 L 12.5 4.3 L 14 5.2 L 16.3 4.5 L 18.3 8 L 16.6 9.6 L 16.6 10.4 L 18.3 12 L 16.3 15.5 L 14 14.8 L 12.5 15.7 L 12 18 L 8 18 L 7.5 15.7 L 6 14.8 L 3.7 15.5 L 1.7 12 L 3.4 10.4 L 3.4 9.6 L 1.7 8 L 3.7 4.5 L 6 5.2 L 7.5 4.3 Z";
                    stroke: #455750;
                    stroke-width: 1.35px;
                }

                Rectangle {
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    border-width: 1.2px;
                    border-color: #455750;
                }
            }
        }

        Rectangle {
            height: 152px;
            border-radius: 12px;
            border-width: 1px;
            border-color: #deebe5;
            background: white;
            Rectangle {
                y: 16px;
                width: 128px;
                height: 68px;
                Rectangle {
                    width: 112px;
                    height: 62px;
                    border-radius: 31px;
                    background: #e8f6ef;
                }

                Rectangle {
                    x: 17px;
                    y: 15px;
                    width: 57px;
                    height: 35px;
                    border-radius: 5px;
                    border-width: 2px;
                    border-color: #478e80;
                    background: #f9fffc;
                    Rectangle {
                        width: 21px;
                        height: 2px;
                        border-radius: 1px;
                        background: #9ad1c2;
                    }
                }

                Rectangle {
                    x: 12px;
                    y: 52px;
                    width: 68px;
                    height: 2px;
                    border-radius: 1px;
                    background: #478e80;
                }

                Rectangle {
                    x: 86px;
                    y: 22px;
                    width: 24px;
                    height: 38px;
                    border-radius: 5px;
                    border-width: 2px;
                    border-color: #478e80;
                    background: #f9fffc;
                    Rectangle {
                        y: 29px;
                        width: 7px;
                        height: 2px;
                        border-radius: 1px;
                        background: #9ad1c2;
                    }
                }

                Rectangle {
                    x: 67px;
                    y: 25px;
                    width: 26px;
                    height: 26px;
                    border-radius: 13px;
                    background: #c7eade;
                    Rectangle {
                        width: 12px;
                        height: 2px;
                        border-radius: 1px;
                        background: #006b60;
                    }

                    Rectangle {
                        width: 2px;
                        height: 12px;
                        border-radius: 1px;
                        background: #006b60;
                    }
                }
            }

            pair-button := Rectangle {
                x: 16px;
                y: 96px;
                width: parent.width - 32px;
                height: 40px;
                border-radius: 6px;
                property <string> label: root.chinese ? "配对新设备" : "Pair a new device";
                background: press.pressed ? #00574f : press.has-hover ? #087b6e : #006b60;
                accessible-role: button;
                accessible-label: self.label;
                accessible-action-default => { root.open-pairing(); }
                forward-focus: key-focus;
                Text {
                    text: pair-button.label;
                    color: white;
                    font-weight: 600;
                }

                if key-focus.has-focus: Rectangle {
                    x: -3px;
                    y: -3px;
                    width: parent.width + 6px;
                    height: parent.height + 6px;
                    border-radius: 8px;
                    border-width: 2px;
                    border-color: #19685b;
                }

                key-focus := FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.Return || event.text == Key.Space {
                            root.open-pairing();
                            return accept;
                        }
                        return reject;
                    }
                }

                press := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-pairing(); }
                }
            }
        }

        VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                height: 20px;
                text: root.chinese ? "已配对设备" : "Paired devices";
                font-size: 14px;
                font-weight: 600;
                color: #264239;
                vertical-alignment: center;
            }

            Rectangle {
                vertical-stretch: 1;
                sender-scroll := ScrollView {
                    vertical-scrollbar-policy: always-off;
                    content-height: list.height;
                    list := Rectangle {
                        y: 0px;
                        width: parent.width;
                        height: root.sender-devices.length == 0 ? 48px
                            : root.sender-devices.length * 49px - 1px + root.editor-height;
                        border-width: 1px;
                        border-color: #deebe5;
                        border-radius: 10px;
                        background: white;
                        if root.sender-devices.length == 0: Text {
                            x: 16px;
                            width: parent.width - 32px;
                            text: root.receiver-revoked
                                ? (root.chinese ? "此接收端已被移除。" : "This Receiver has been removed.")
                                : root.receiver-credential-missing
                                ? (root.chinese ? "无法读取本地接收凭据。" : "Could not read the local Receiver credential.")
                                : (root.chinese ? "还没有已配对的设备。" : "No devices paired yet.");
                            font-size: 13px;
                            color: #65716e;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }

                        for sender[index] in root.sender-devices: SenderRow {
                            y: index * 49px + (root.editor >= 0 && index > root.editor ? root.editor-height : 0px);
                            height: 48px + self.editor-height + (self.separator ? 1px : 0px);
                            device: sender;
                            chinese: root.chinese;
                            expanded: index == root.editor;
                            separator: index + 1 < root.sender-devices.length;
                            focus-requested: index == 0 && root.focus-first-row;
                            focus-by-pointer: root.focus-by-pointer;
                            editor-height: self.expanded ? root.editor-height : 0px;
                            error <=> root.editor-error;
                            toggle => {
                                if self.expanded {
                                    root.close-editor();
                                } else {
                                    root.editor = index;
                                    root.editor-error = "";
                                    self.reveal-editor();
                                }
                            }
                            rename(draft, invalid) => { root.rename-sender(index, draft, invalid) }
                            delete-local(pointer) => { root.delete-sender(index, pointer) }
                            read-paste => { root.read-name-paste() }
                            insert-paste(text) => { root.insert-name-paste(text); }
                            reveal-editor => { root.reveal(self.y + 48px, self.y + 48px + self.editor-height); }
                            reveal-row => { root.reveal(self.y, self.y + 48px); }
                        }
                    }
                }

                if list.height > sender-scroll.visible-height: SenderScrollbar {
                    x: parent.width + 12px;
                    height: parent.height;
                    content-height: list.height;
                    offset <=> sender-scroll.content-y;
                    label: root.chinese ? "滚动已配对设备列表" : "Scroll paired devices";
                }
            }
        }
    }
}
